{
  "extends": [
    "github>harryzcy/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Homebrew install script pinned to a commit",
      "managerFilePatterns": [
        "/^install$/",
        "/^script/setup/util_macos\\.sh$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/Homebrew/install/(?<currentDigest>[0-9a-f]{40})/install\\.sh"
      ],
      "depNameTemplate": "Homebrew/install",
      "packageNameTemplate": "https://github.com/Homebrew/install",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ]
}
